unit NEOWatch.WebApp.Persistence.Repository.AsteroidDetail;

interface

uses
  Fido.Utilities,
  NEOWatch.WebApp.Domain.Entity.AsteroidDetail.Intf,
  NEOWatch.WebApp.Domain.AsteroidDetailRepository.Intf,
  NEOWatch.WebApp.Persistence.Gateway.NasaApi.Intf,
  JsonDataObjects,
  System.SysUtils,
  Fido.Mappers;

type

  TAsteroidDetailRepository = class(TInterfacedObject, IAsteroidDetailRepository)
  private
    FNasaNeoWsApi: INasaNeoWsApi;
  public
    function GetById(const Id: string): IAsteroidDetail;

    constructor Create(const NasaNeoWsApi: INasaNeoWsApi);
  end;

implementation

constructor TAsteroidDetailRepository.Create(const NasaNeoWsApi: INasaNeoWsApi);
begin
  inherited Create;
  FNasaNeoWsApi := Utilities.CheckNotNullAndSet(NasaNeoWsApi, 'NasaNeoWsApi');
end;

function TAsteroidDetailRepository.GetById(const Id: string): IAsteroidDetail;
var
  ResponseJson: string;
  Root: TJSONObject;
begin
  if Id.Trim.IsEmpty then
    raise Exception.Create('Asteroid id is required.');

  ResponseJson := FNasaNeoWsApi.GetAsteroidById(Id);

  Root := TJSONObject.ParseJSONValue(ResponseJson) as TJSONObject;
  try
    if not Assigned(Root) then
      raise Exception.Create('Invalid NASA asteroid detail JSON.');

    Result := nil;

    Mappers.Map<TJSONObject, IAsteroidDetail>(Root, Result);
  finally
    Root.Free;
  end;
end;

end.
