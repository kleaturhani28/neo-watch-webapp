class procedure NEOWatchRegistrations.Register(const Container: TContainer; const FileIni: TMemIniFile);
begin
  Container.RegisterInstance<TMemIniFile>(FileIni);

  // Logging
  Container.RegisterType<ILogAppender>(
      function: ILogAppender
      var
        LogFile: string;
      begin
        LogFile :=
            FileIni.ReadString(
                'Log',
                'Filename',
                FileIni.ReadString('params', 'logfile', TPath.ChangeExtension(ParamStr(0), '.log'))
            );
        Result := TPermanentFileLogAppender.Create(LogFile);
      end,
      'logappender.file'
  );

  Container.RegisterType<ILogAppender>(
      function: ILogAppender //
      begin
        result := TConsoleLogAppender.Create;
      end,
      'logappender.console'
  );

  Container
      .RegisterType<ILogger>(
          function: ILogger
          begin
            Result :=
                TLogger.Create(
                    TLoggerController.Create(
                        [
{$IF not defined(LINUX)}
                            Container.Resolve<ILogAppender>('logappender.file'),
{$ENDIF}
                            Container.Resolve<ILogAppender>('logappender.console')
                        ]
                    )
                );
          end)
      .AsSingleton;

  // Redis
  Container.RegisterType<IRedisClient>(
      function: IRedisClient
      begin
        result :=
            Retries.Run<IRedisClient>(
                function: IRedisClient
                begin
                  Result :=
                      TRedisClient.Create(
                          FileIni.ReadString('RedisServer', 'Address', '127.0.0.1'),
                          FileIni.ReadInteger('RedisServer', 'Port', 6379)
                      );
                  Result.Connect;
                end,
                function(const E: Exception): Boolean
                begin
                  Container.Resolve<ILogger>.Error('Redis not ready... ', E);
                  result := True;
                end,
                10,
                1000
            );
      end
  );
  Container.RegisterType<IFidoRedisClient, TFidoRedisClient>;
  Container.RegisterFactory<IFidoRedisClientFactory>;

  // KVStore
  Container.RegisterType<IKVStore>(
      function: IKVStore
      begin
        Result := TRedisKVStore.Create(Container.Resolve<IFidoRedisClient>, 'neowatch.webapp.');
      end
  );

  // Presentation

  // - Models

  // - Services
  Container.RegisterType<ISessionService, TSessionService>;

  // - Views
  Container.RegisterType<IViewMain, TViewMainSempare>;
  Container.RegisterType<IViewMonitoring, TViewMonitoringSempare>;
  Container.RegisterType<IViewAsteroidDetail, TViewAsteroidDetailSempare>;

  // - Models
  Container.RegisterType<IModelMonitoring, TModelMonitoring>;

  // - Controllers
  Container.RegisterType<IMainController, TMainController>;
  Container.RegisterType<IAsteroidsController, TAsteroidsController>;

  // Usecases

  // Repositories
  Container.RegisterType<ISessionRepository, TSessionRepository>;
  Container.RegisterType<IMonitoringRepository, TMonitoringRepository>;

  // Gateways

  // Entities
  Container.RegisterType<IAsteroid, TAsteroid>;
  Container.RegisterType<IAsteroidFilters, TAsteroidFilters>;
  Container.RegisterType<IMonitoring, TMonitoring>;
  Container.RegisterType<ISession, TSession>;

  // ValueObjects

  // Other stuff - Sempare Template Engine

{$IF defined(DEBUG) and not defined(LINUX)}
  TemplateRootFolder :=
      FileIni.ReadString(
          'Templates',
          'RootFolder',
          'C:\FreelancerProjects.Demo\Delphi\NEOWatch\Source\WebApp\Presentation\Views\Templates'
      );

{$ELSE}
  TemplateRootFolder := TPath.Combine([TPath.GetLibraryPath, 'Templates']);
{$ENDIF}

  TemplateRootFolder := FileIni.ReadString('Templates', 'RootFolder', TemplateRootFolder);

  TTemplateRegistry.Instance.TemplateRootFolder := TemplateRootFolder;
  TTemplateRegistry.Instance.TemplateFileExt := '.html';
  TTemplateRegistry.Instance.LoadStrategy := [tlsLoadFile];
  TTemplateRegistry.Instance.AutomaticRefresh := False;

  // {$IF defined(DEBUG)}
  //  TTemplateRegistry.Instance.AutomaticRefresh := True;
  //  TTemplateRegistry.Instance.RefreshIntervalS := 2;
  // {$ELSE}
  //  TTemplateRegistry.Instance.AutomaticRefresh := False;
  // {$ENDIF}

  TTemplateRegistry.Instance.ExceptionLogger :=
      procedure(const E: Exception)
      begin
        //
        OutputDebugString(PChar('Sempare template error: ' + E.Message));
      end;

  // Build the container
  Container.Build;

  //  // Register environment
  //  EnvironmentRegister.Register('TEST', 'TEST', 'Test');
end;

class procedure NEOWatchRegistrations.RegisterCommandLine(const Container: TContainer);
var
  cmd: TCommandDefinition;
  option: IOptionDefinition;
begin
  // Common options for all commands

  // Inifile
  option :=
      TOptionsRegistry.RegisterOption<string>(
          Constants.CommandLine.ConfigOption,
          Constants.CommandLine.ConfigOptionShort,
          'The INI file name for common configurations',
          procedure(const value: string) begin Container.Resolve<IConfigOptions>.SetIniFileName(value); end
      );

  // Logfile
  option :=
      TOptionsRegistry.RegisterOption<string>(
          Constants.CommandLine.LogFile,
          Constants.CommandLine.LogFileShort,
          'The LOG file name for common logging',
          procedure(const value: string) begin Container.Resolve<IConfigOptions>.SetLogFileName(value); end
      );

  // Help
  cmd :=
      TOptionsRegistry.RegisterCommand(
          Constants.CommandLine.HelpCommand,
          Constants.CommandLine.HelpCommandAlias,
          'get some help',
          '',
          'help [comando]'
      );
  option :=
      cmd.RegisterUnNamedOption<string>(
          '''Choose one of the following commands:''',
          'command',
          procedure(const value: string) begin Container.Resolve<IHelpOptions>.SetHelpCommand(value); end
      );

  Container.RegisterType<IConfigOptions, TConfigOptions>.AsSingleton;
  Container.RegisterType<IHelpOptions, THelpOptions>.AsSingleton;
  Container.RegisterType<IRunOptions, TRunOptions>.AsSingleton;

  Container.RegisterType<IFidoCommandLine, TFidoCommandLine>.AsSingleton;

  // Must be built for reading the commandline!
  Container.Build;

end;

