<!DOCTYPE html>
<html lang="it" data-bs-theme="dark">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Asteroid Monitoring</title>

  <link rel="icon" href="data:,">

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.10.8/dist/sweetalert2.min.css" rel="stylesheet">

  <style>
    :root {
      --nasa-bg: #07090f;
      --nasa-panel: rgba(15, 18, 28, 0.92);
      --nasa-panel-soft: rgba(255, 255, 255, 0.055);
      --nasa-border: rgba(255, 255, 255, 0.11);
      --nasa-border-strong: rgba(110, 231, 255, 0.35);
      --nasa-text: #f4f7fb;
      --nasa-muted: #9ba7b7;
      --nasa-cyan: #6ee7ff;
      --nasa-blue: #3b82f6;
      --nasa-green: #22c55e;
      --nasa-orange: #f59e0b;
      --nasa-red: #ef4444;
      --nasa-purple: #a855f7;
      --nasa-radius: 18px;
    }

    html,
    body {
      font-family: 'Inter', system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
      font-size: 14px;
      line-height: 1.35;
    }

    body {
      min-height: 100vh;
      background:
        radial-gradient(circle at 75% 10%, rgba(59, 130, 246, 0.22), transparent 24%),
        radial-gradient(circle at 15% 25%, rgba(110, 231, 255, 0.10), transparent 18%),
        radial-gradient(circle at 82% 82%, rgba(168, 85, 247, 0.14), transparent 26%),
        linear-gradient(135deg, #03040a 0%, #080b12 48%, #0e111c 100%);
      color: var(--nasa-text);
      overflow-x: hidden;
    }

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      pointer-events: none;
      background-image:
        radial-gradient(circle, rgba(255, 255, 255, .65) 0 1px, transparent 1.5px),
        radial-gradient(circle, rgba(110, 231, 255, .35) 0 1px, transparent 1.4px);
      background-size: 120px 120px, 210px 210px;
      background-position: 30px 40px, 80px 100px;
      opacity: .28;
      z-index: -1;
    }

    h1,
    h2,
    h3,
    h4,
    h5,
    h6 {
      letter-spacing: -0.02em;
    }

    .app-shell {
      width: min(1560px, calc(100% - 32px));
      margin: 0 auto;
      padding: 24px 0 40px;
    }

    .glass-card {
      background: var(--nasa-panel);
      border: 1px solid var(--nasa-border);
      border-radius: var(--nasa-radius);
      box-shadow: 0 20px 60px rgba(0, 0, 0, .22);
      backdrop-filter: blur(18px);
      transition: border-color .18s ease, box-shadow .18s ease;
    }

    .glass-card:hover {
      border-color: rgba(110, 231, 255, .18);
    }

    .dashboard-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
      margin-bottom: 18px;
    }

    .brand-block {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .brand-logo {
      width: 54px;
      height: 54px;
      border-radius: 17px;
      display: grid;
      place-items: center;
      background:
        radial-gradient(circle at 30% 25%, rgba(255, 255, 255, .65), transparent 18%),
        linear-gradient(135deg, var(--nasa-blue), var(--nasa-cyan));
      color: #031018;
      font-size: 25px;
      box-shadow: 0 0 35px rgba(110, 231, 255, .24);
      transform: rotate(-10deg);
    }

    .brand-title {
      margin: 0;
      font-size: clamp(28px, 3.4vw, 44px);
      font-weight: 850;
      letter-spacing: -.04em;
    }

    .brand-subtitle {
      color: var(--nasa-muted);
      font-size: 14px;
      margin-top: 3px;
    }

    .status-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      border: 1px solid var(--nasa-border);
      border-radius: 999px;
      background: rgba(255, 255, 255, .055);
      color: var(--nasa-text);
      padding: 8px 12px;
      font-size: 13px;
      white-space: nowrap;
    }

    .status-dot {
      width: 8px;
      height: 8px;
      border-radius: 999px;
      background: var(--nasa-green);
      box-shadow: 0 0 14px var(--nasa-green);
    }

    .btn-ghost {
      border: 1px solid var(--nasa-border);
      background: rgba(255, 255, 255, .055);
      color: var(--nasa-text);
      border-radius: 12px;
    }

    .btn-ghost:hover {
      border-color: rgba(110, 231, 255, .38);
      color: var(--nasa-cyan);
      background: rgba(110, 231, 255, .08);
    }

    .btn-nasa {
      border: 0;
      background: linear-gradient(135deg, var(--nasa-blue), var(--nasa-cyan));
      color: #031018;
      font-weight: 800;
      border-radius: 12px;
      min-height: 40px;
      box-shadow: 0 0 22px rgba(110, 231, 255, .16);
    }

    .btn-nasa:hover {
      filter: brightness(1.05);
      color: #031018;
    }

    .nasa-tabs .nav-link {
      color: var(--nasa-muted);
      border: 1px solid transparent;
      border-radius: 999px;
      padding: 9px 15px;
    }

    .nasa-tabs .nav-link.active {
      background: rgba(110, 231, 255, .13);
      border-color: rgba(110, 231, 255, .28);
      color: var(--nasa-cyan);
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 300px minmax(420px, 1fr) 320px;
      gap: 18px;
      align-items: stretch;
    }

    .content-grid {
      margin-top: 18px;
      display: grid;
      grid-template-columns: minmax(0, 1.35fr) minmax(340px, .8fr);
      gap: 18px;
      align-items: start;
    }

    .filters-card,
    .space-scene,
    .active-threat-card,
    .mission-status-card,
    .results-card,
    .charts-card,
    .detail-card {
      padding: 18px;
      min-width: 0;
    }

    .section-title {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 14px;
    }

    .section-title h2,
    .section-title h3 {
      margin: 0;
      font-size: 17px;
      font-weight: 800;
    }

    .section-title small {
      color: var(--nasa-muted);
    }

    .filters .row {
      --bs-gutter-y: .75rem;
    }

    .form-label {
      color: #cbd5e1;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: .08em;
      font-weight: 750;
    }

    .form-control,
    .form-select {
      min-height: 38px;
      font-size: 13px;
      background-color: rgba(255, 255, 255, .06);
      border-color: rgba(255, 255, 255, .13);
      color: var(--nasa-text);
      border-radius: 12px;
    }

    .form-control:focus,
    .form-select:focus {
      background-color: rgba(255, 255, 255, .08);
      color: var(--nasa-text);
      border-color: rgba(110, 231, 255, .48);
      box-shadow: 0 0 0 .25rem rgba(110, 231, 255, .10);
    }

    .form-select option {
      background: #111827;
      color: #fff;
    }

    .metric-list {
      display: grid;
      gap: 12px;
    }

    .metric-card {
      padding: 16px;
      border-radius: 16px;
      background: rgba(255, 255, 255, .055);
      border: 1px solid rgba(255, 255, 255, .085);
    }

    .metric-card-primary {
      border-color: rgba(110, 231, 255, .18);
    }

    .metric-card-danger {
      border-color: rgba(239, 68, 68, .20);
    }

    .metric-card-source {
      border-color: rgba(34, 197, 94, .18);
    }

    .metric-label {
      color: var(--nasa-muted);
      font-size: 12px;
      margin-bottom: 8px;
    }

    .metric-value {
      font-size: 28px;
      line-height: 1;
      font-weight: 850;
      font-variant-numeric: tabular-nums;
    }

    .metric-value small {
      font-size: 13px;
      color: var(--nasa-muted);
      font-weight: 500;
    }

    .metric-trend {
      font-size: 12px;
      margin-top: 8px;
    }

    .trend-good {
      color: var(--nasa-green);
    }

    .trend-warn {
      color: var(--nasa-orange);
    }

    .trend-danger {
      color: var(--nasa-red);
    }

    .space-scene {
      position: relative;
      min-height: 390px;
      overflow: hidden;
      background:
        radial-gradient(circle at 60% 28%, rgba(255, 255, 255, .18), transparent 16%),
        radial-gradient(circle at 24% 70%, rgba(110, 231, 255, .09), transparent 22%),
        rgba(255, 255, 255, .035);
    }

    .scene-toolbar {
      position: relative;
      z-index: 5;
      display: flex;
      justify-content: space-between;
      gap: 12px;
      align-items: flex-start;
    }

    .scene-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      border: 1px solid rgba(110, 231, 255, .28);
      background: rgba(110, 231, 255, .09);
      color: var(--nasa-cyan);
      border-radius: 999px;
      padding: 7px 12px;
      font-size: 12px;
      white-space: nowrap;
    }

    .toolbar-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: flex-end;
      gap: 8px;
    }

    .space-scene .toolbar-actions {
      max-width: 58%;
    }

    .space-scene .toolbar-actions .btn {
      white-space: nowrap;
    }

    .main-asteroid {
      position: absolute;
      left: 50%;
      top: 54%;
      width: min(520px, 78%);
      height: 250px;
      transform: translate(-50%, -50%) rotate(-14deg);
      clip-path: polygon(4% 49%, 13% 29%, 34% 9%, 64% 4%, 90% 18%, 98% 42%, 86% 66%, 61% 88%, 30% 95%, 9% 76%);
      background:
        radial-gradient(circle at 24% 33%, rgba(255, 255, 255, .82), transparent 8%),
        radial-gradient(circle at 39% 50%, rgba(0, 0, 0, .72), transparent 10%),
        radial-gradient(circle at 67% 39%, rgba(0, 0, 0, .68), transparent 9%),
        radial-gradient(circle at 72% 68%, rgba(255, 255, 255, .28), transparent 10%),
        radial-gradient(circle at 31% 74%, rgba(0, 0, 0, .62), transparent 10%),
        linear-gradient(135deg, #111 0%, #4b5251 22%, #d6dbda 47%, #5b6261 62%, #111 100%);
      filter: grayscale(.7) contrast(1.14);
      box-shadow:
        inset -80px -35px 110px rgba(0, 0, 0, .88),
        inset 40px 24px 85px rgba(255, 255, 255, .22),
        0 34px 90px rgba(255, 255, 255, .13);
      opacity: .96;
    }

    .orbit-line {
      position: absolute;
      inset: 76px 86px;
      border: 1px dashed rgba(110, 231, 255, .17);
      border-radius: 50%;
      transform: rotate(-18deg);
    }

    .planet-mini {
      position: absolute;
      left: 42px;
      bottom: 45px;
      width: 135px;
      height: 135px;
      border-radius: 50%;
      background:
        radial-gradient(circle at 65% 34%, rgba(255, 255, 255, .38), transparent 12%),
        radial-gradient(circle at 50% 50%, #9aa2a2 0, #3d4545 34%, #0a0c0c 72%);
      box-shadow: inset -22px -20px 52px rgba(0, 0, 0, .82);
      opacity: .72;
    }

    .target-ring {
      position: absolute;
      left: 44%;
      top: 57%;
      width: 64px;
      height: 64px;
      border-radius: 50%;
      border: 1px solid rgba(255, 255, 255, .55);
      display: grid;
      place-items: center;
      background: rgba(0, 0, 0, .25);
    }

    .target-ring::before {
      content: "";
      position: absolute;
      inset: 13px;
      border: 1px solid rgba(255, 255, 255, .25);
      border-radius: 50%;
    }

    .target-ring::after {
      content: "−";
      color: rgba(255, 255, 255, .72);
      font-size: 30px;
      margin-top: -4px;
    }

    .scene-note {
      position: absolute;
      z-index: 5;
      max-width: 150px;
      padding: 7px 9px;
      border-radius: 12px;
      background: rgba(3, 7, 18, .42);
      border: 1px solid rgba(255, 255, 255, .08);
      backdrop-filter: blur(8px);
      font-size: 12px;
      color: #e2e8f0;
    }

    .scene-note small {
      display: block;
      color: var(--nasa-muted);
      margin-top: 4px;
    }

    .note-diameter {
      left: 50%;
      top: 24%;
    }

    .note-composition {
      left: 7%;
      top: 48%;
      text-align: center;
    }

    .note-distance {
      right: 7%;
      bottom: 18%;
    }

    .right-stack {
      display: grid;
      gap: 18px;
    }

    .threat-visual {
      height: 96px;
      margin: 4px 0 14px;
      position: relative;
      border-radius: 16px;
      background:
        radial-gradient(ellipse at 50% 50%, rgba(255, 255, 255, .75), rgba(92, 99, 98, .54) 43%, transparent 45%),
        rgba(255, 255, 255, .045);
      filter: grayscale(.85);
      transform: rotate(7deg);
    }

    .risk-badge {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      border-radius: 999px;
      padding: 6px 12px;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: .02em;
    }

    .risk-danger {
      background: rgba(239, 68, 68, .20);
      color: #fecaca;
      border: 1px solid rgba(239, 68, 68, .55);
      box-shadow: 0 0 18px rgba(239, 68, 68, .12);
    }

    .risk-safe {
      background: rgba(34, 197, 94, .18);
      color: #bbf7d0;
      border: 1px solid rgba(34, 197, 94, .45);
    }

    .neo-table {
      display: grid;
      gap: 7px;
    }

    .neo-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      border-radius: 12px;
      background: rgba(255, 255, 255, .065);
      padding: 10px;
      font-size: 13px;
    }

    .neo-row span:first-child {
      color: var(--nasa-muted);
    }

    .neo-row span:last-child {
      min-width: 0;
      text-align: right;
      font-weight: 750;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .mission-status-box {
      display: grid;
      gap: 10px;
    }

    .mission-status-box div {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      padding: 11px 12px;
      border-radius: 12px;
      background: rgba(255, 255, 255, .055);
    }

    .mission-status-box span {
      color: var(--nasa-muted);
    }

    .mission-status-box strong {
      color: var(--nasa-cyan);
    }

    .asteroid-list {
      display: grid;
      gap: 12px;
    }

    .asteroid-card {
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: 16px;
      align-items: center;
      padding: 17px 18px;
      border-radius: 18px;
      background: linear-gradient(90deg, rgba(255, 255, 255, .075), rgba(255, 255, 255, .035));
      border: 1px solid rgba(255, 255, 255, .11);
      transition: transform .18s ease, border-color .18s ease, background .18s ease, box-shadow .18s ease;
    }

    .asteroid-card:hover {
      transform: translateY(-2px);
      border-color: rgba(110, 231, 255, .35);
      background: linear-gradient(90deg, rgba(110, 231, 255, .10), rgba(255, 255, 255, .045));
    }

    .asteroid-card.selected {
      border-color: rgba(110, 231, 255, .65);
      box-shadow:
        0 0 0 1px rgba(110, 231, 255, .18),
        0 18px 48px rgba(110, 231, 255, .08);
    }

    .asteroid-card.dangerous {
      border-color: rgba(239, 68, 68, .45);
      background: linear-gradient(90deg, rgba(239, 68, 68, .14), rgba(255, 255, 255, .045));
    }

    .asteroid-icon {
      width: 54px;
      height: 54px;
      border-radius: 16px;
      display: grid;
      place-items: center;
      background:
        radial-gradient(circle at 35% 30%, rgba(255, 255, 255, .75), transparent 12%),
        linear-gradient(135deg, #d1d5db, #374151);
      color: #111827;
      filter: grayscale(.6);
      transform: rotate(-12deg);
    }

    .asteroid-title {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
      min-width: 0;
      margin-bottom: 5px;
    }

    .asteroid-title h4 {
      margin: 0;
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      font-size: 18px;
      font-weight: 850;
    }

    .asteroid-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      min-width: 0;
      color: var(--nasa-muted);
      font-size: 12px;
    }

    .chart-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }

    .chart-placeholder {
      min-height: 250px;
      border-radius: 16px;
      padding: 14px;
      border: 1px dashed rgba(255, 255, 255, .18);
      background: rgba(255, 255, 255, .035);
      position: relative;
      overflow: hidden;
    }

    .fake-line-chart {
      position: absolute;
      inset: 52px 18px 28px;
      border-left: 1px solid rgba(255, 255, 255, .16);
      border-bottom: 1px solid rgba(255, 255, 255, .16);
    }

    .fake-line-chart::before {
      content: "";
      position: absolute;
      left: 8px;
      right: 8px;
      bottom: 45px;
      height: 80px;
      background:
        linear-gradient(135deg, transparent 0 15%, var(--nasa-cyan) 16% 18%, transparent 19% 36%, var(--nasa-cyan) 37% 39%, transparent 40% 62%, var(--nasa-cyan) 63% 65%, transparent 66%),
        linear-gradient(to top, rgba(110, 231, 255, .12), transparent);
      opacity: .9;
    }

    .fake-bars {
      position: absolute;
      inset: 62px 22px 32px;
      display: flex;
      align-items: end;
      gap: 10px;
      border-left: 1px solid rgba(255, 255, 255, .16);
      border-bottom: 1px solid rgba(255, 255, 255, .16);
      padding-left: 16px;
    }

    .fake-bars span {
      width: 22px;
      border-radius: 8px 8px 0 0;
      background: linear-gradient(180deg, var(--nasa-cyan), rgba(59, 130, 246, .55));
    }

    .detail-empty {
      min-height: 280px;
      display: grid;
      place-items: center;
      text-align: center;
      color: var(--nasa-muted);
      border-radius: 16px;
      border: 1px dashed rgba(255, 255, 255, .15);
      background: rgba(255, 255, 255, .035);
      padding: 24px;
    }

    .detail-panel {
      width: 100%;
    }

    .detail-panel h4 {
      color: #fff;
      font-size: 20px;
      font-weight: 850;
    }

    .detail-chip {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      margin-bottom: 14px;
      padding: 5px 10px;
      border-radius: 999px;
      background: rgba(110, 231, 255, .10);
      border: 1px solid rgba(110, 231, 255, .25);
      color: var(--nasa-cyan);
      font-size: 12px;
      font-weight: 750;
    }

    .detail-section-title {
      margin: 0 0 10px;
      color: #e5e7eb;
      font-size: 13px;
      text-transform: uppercase;
      letter-spacing: .08em;
      font-weight: 850;
    }

    .detail-kv {
      display: grid;
      gap: 8px;
    }

    .detail-kv div {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      padding: 10px;
      border-radius: 12px;
      background: rgba(255, 255, 255, .055);
      border: 1px solid rgba(255, 255, 255, .06);
      font-size: 13px;
    }

    .detail-kv span:first-child {
      color: var(--nasa-muted);
    }

    .detail-kv strong {
      text-align: right;
      color: #e5e7eb;
    }

    .close-approach-list {
      display: grid;
      gap: 8px;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .close-approach-item {
      display: grid;
      gap: 3px;
      padding: 10px;
      border-radius: 12px;
      background: rgba(255, 255, 255, .055);
      border: 1px solid rgba(255, 255, 255, .06);
    }

    .close-approach-item strong {
      color: #e5e7eb;
      font-size: 13px;
    }

    .close-approach-item span {
      color: var(--nasa-muted);
      font-size: 12px;
    }

    .detail-loading {
      margin-top: 12px;
      color: var(--nasa-cyan);
      font-size: 13px;
    }

    .loader-overlay {
      position: fixed;
      left: 50%;
      bottom: 28px;
      transform: translateX(-50%);
      z-index: 2000;
      padding: 11px 18px;
      border-radius: 999px;
      background: rgba(3, 7, 18, .92);
      border: 1px solid var(--nasa-border-strong);
      color: var(--nasa-cyan);
      box-shadow: 0 10px 40px rgba(0, 0, 0, .32);
      display: none;
    }

    .loader-overlay.htmx-request {
      display: block;
    }

    .toast-target:not(:empty) {
      position: fixed;
      right: 24px;
      bottom: 24px;
      z-index: 2100;
      width: min(420px, calc(100% - 48px));
    }

    @media (max-width: 1450px) {
      .hero-grid {
        grid-template-columns: 300px minmax(0, 1fr);
      }

      .right-stack {
        grid-column: 1 / -1;
        grid-template-columns: 1fr 1fr;
      }

      .content-grid {
        grid-template-columns: 1fr;
      }

      .space-scene .toolbar-actions {
        max-width: 48%;
      }

      .space-scene .toolbar-actions .btn {
        font-size: 12px;
        padding: 6px 9px;
      }
    }

    @media (max-width: 1100px) {
      .scene-note {
        display: none;
      }
    }

    @media (max-width: 900px) {
      body {
        padding: 14px;
      }

      .dashboard-header,
      .nav {
        flex-wrap: wrap;
      }

      .hero-grid,
      .right-stack,
      .content-grid,
      .chart-grid {
        grid-template-columns: 1fr;
      }

      .space-scene {
        min-height: 360px;
      }

      .space-scene .toolbar-actions {
        max-width: 100%;
        justify-content: flex-start;
      }

      .main-asteroid {
        width: 92%;
        height: 210px;
      }

      .asteroid-card {
        grid-template-columns: auto 1fr;
      }

      .asteroid-card .btn {
        grid-column: 1 / -1;
      }
    }

    /* =========================================================
   Asteroid list pagination
   ========================================================= */

    .asteroid-list-toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      margin-bottom: 14px;
      padding: 10px 12px;
      border-radius: 14px;
      background: rgba(255, 255, 255, .04);
      border: 1px solid rgba(255, 255, 255, .07);
    }

    .list-counter {
      display: inline-flex;
      align-items: center;
      color: var(--nasa-muted);
      font-size: 13px;
    }

    .list-counter strong {
      color: var(--nasa-text);
      font-weight: 800;
    }

    .page-size-control {
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .page-size-control label {
      color: var(--nasa-muted);
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: .08em;
      font-weight: 800;
    }

    .page-size-control .form-select {
      width: 82px;
      min-height: 34px;
      padding-top: 4px;
      padding-bottom: 4px;
    }

    .asteroid-pagination {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      margin-top: 16px;
      padding-top: 14px;
      border-top: 1px solid rgba(255, 255, 255, .08);
    }

    .pagination-pages {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 6px;
    }

    .pagination-page-btn {
      min-width: 34px;
      height: 34px;
      border-radius: 10px;
      border: 1px solid rgba(255, 255, 255, .10);
      background: rgba(255, 255, 255, .055);
      color: var(--nasa-text);
      font-size: 13px;
      font-weight: 750;
    }

    .pagination-page-btn:hover {
      border-color: rgba(110, 231, 255, .38);
      color: var(--nasa-cyan);
      background: rgba(110, 231, 255, .08);
    }

    .pagination-page-btn.active {
      background: linear-gradient(135deg, var(--nasa-blue), var(--nasa-cyan));
      color: #031018;
      border-color: transparent;
    }

    .asteroid-page-item.is-hidden {
      display: none;
    }

    @media (max-width: 700px) {

      .asteroid-list-toolbar,
      .asteroid-pagination {
        align-items: stretch;
        flex-direction: column;
      }

      .pagination-pages {
        order: -1;
      }

      .page-size-control {
        justify-content: space-between;
      }
    }

    /* =========================================================
   Mission visualizer
   ========================================================= */

    .mission-visualizer {
      isolation: isolate;
    }

    .visualizer-overlay {
      position: absolute;
      left: 18px;
      right: 18px;
      bottom: 18px;
      z-index: 7;
      display: grid;
      grid-template-columns: minmax(0, 1fr) 1.25fr;
      gap: 14px;
      align-items: end;
      pointer-events: none;
    }

    .visualizer-title {
      padding: 14px;
      border-radius: 16px;
      background: rgba(3, 7, 18, .58);
      border: 1px solid rgba(255, 255, 255, .10);
      backdrop-filter: blur(10px);
    }

    .visualizer-title h3 {
      margin: 10px 0 6px;
      font-size: 22px;
      font-weight: 850;
    }

    .visualizer-title p {
      margin: 0;
      color: var(--nasa-muted);
      font-size: 13px;
      line-height: 1.45;
    }

    .visualizer-stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
    }

    .visualizer-stats div {
      padding: 12px;
      border-radius: 14px;
      background: rgba(3, 7, 18, .58);
      border: 1px solid rgba(255, 255, 255, .10);
      backdrop-filter: blur(10px);
    }

    .visualizer-stats span {
      display: block;
      color: var(--nasa-muted);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: .08em;
      margin-bottom: 5px;
    }

    .visualizer-stats strong {
      color: var(--nasa-text);
      font-size: 13px;
      font-weight: 850;
      word-break: break-word;
    }

    @media (max-width: 1100px) {
      .visualizer-overlay {
        grid-template-columns: 1fr;
      }

      .visualizer-stats {
        grid-template-columns: 1fr;
      }
    }

    /* =========================================================
   Recharts-like chart cards
   ========================================================= */

    .charts-dashboard {
      padding: 22px;
    }

    .charts-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 18px;
      margin-bottom: 22px;
    }

    .charts-header h2 {
      margin: 0 0 8px;
      font-size: 30px;
      font-weight: 900;
    }

    .charts-header p {
      margin: 0;
      color: var(--nasa-muted);
      max-width: 760px;
    }

    .charts-example-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px;
    }

    .chart-example-card {
      min-width: 0;
      overflow: hidden;
      border-radius: 18px;
      background: rgba(255, 255, 255, .035);
      border: 1px solid rgba(255, 255, 255, .13);
      box-shadow: 0 18px 50px rgba(0, 0, 0, .22);
    }

    .chart-example-body {
      height: 260px;
      padding: 14px;
      background:
        radial-gradient(circle at 50% 0%, rgba(110, 231, 255, .08), transparent 28%),
        rgba(0, 0, 0, .18);
      border-bottom: 1px solid rgba(255, 255, 255, .10);
    }

    .chart-example-body canvas {
      width: 100% !important;
      height: 100% !important;
    }

    .chart-example-footer {
      min-height: 72px;
      padding: 16px 18px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
    }

    .chart-example-footer h3 {
      margin: 0 0 4px;
      font-size: 16px;
      font-weight: 900;
    }

    .chart-example-footer small {
      color: var(--nasa-muted);
    }

    .chart-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      border-radius: 999px;
      padding: 7px 10px;
      background: rgba(110, 231, 255, .10);
      border: 1px solid rgba(110, 231, 255, .24);
      color: var(--nasa-cyan);
      font-size: 11px;
      font-weight: 850;
      white-space: nowrap;
    }

    .chart-badge.warning {
      background: rgba(245, 158, 11, .12);
      border-color: rgba(245, 158, 11, .28);
      color: #fbbf24;
    }

    @media (max-width: 1250px) {
      .charts-example-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 780px) {
      .charts-header {
        flex-direction: column;
      }

      .charts-example-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

<body>
  <div class="app-shell">

    <!-- HEADER -->
