          <div class="brand-subtitle">
            Real-time view of near-Earth asteroids, risk level and close approach data.
          </div>
        </div>
      </div>

      <div class="d-flex align-items-center flex-wrap gap-2">
        <span class="status-pill">
          <span class="status-dot"></span>
          Live data
        </span>

        <span class="status-pill">
          <i class="fa-solid fa-meteor text-info"></i>
          NASA NeoWs
        </span>

        <span class="status-pill">
          <i class="fa-solid fa-triangle-exclamation text-warning"></i>
          Risk monitor
        </span>

        <button class="btn btn-sm btn-ghost" type="button" data-bs-toggle="modal" data-bs-target="#apiInfoModal">
