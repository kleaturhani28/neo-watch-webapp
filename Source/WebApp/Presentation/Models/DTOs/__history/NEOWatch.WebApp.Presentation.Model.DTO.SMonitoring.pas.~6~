unit NEOWatch.WebApp.Presentation.Model.DTO.SMonitoring;

interface

uses
  NEOWatch.WebApp.Presentation.Model.DTO.SAsteroidFilters,
  System.Generics.Collections,
  NEOWatch.WebApp.Presentation.Model.DTO.SAsteroidSummary,
  NEOWatch.WebApp.Presentation.Model.DTO.SAsteroidCard,
  NEOWatch.WebApp.Presentation.Model.DTO.SAsteroidDetails;

type
  TSMonitoringDTO = class
  private
    FFilters: TSAsteroidFiltersDTO;
    FSummary: TSAsteroidSummaryDTO;
    FAsteroids: TObjectList<TSAsteroidCardDTO>;
    FSelectedAsteroid: TSAsteroidDetailDTO;
    FHasSelectedAsteroid: Boolean;
    FErrorMessage: string;
    FHasError: Boolean;

    function GetFilters: TSAsteroidFiltersDTO;
    function GetSummary: TSAsteroidSummaryDTO;
    function GetAsteroids: TObjectList<TSAsteroidCardDTO>;
    function GetSelectedAsteroid: TSAsteroidDetailDTO;
    function GetHasSelectedAsteroid: Boolean;
    function GetErrorMessage: string;
    function GetHasError: Boolean;

    procedure SetFilters(const Value: TSAsteroidFiltersDTO);
    procedure SetSummary(const Value: TSAsteroidSummaryDTO);
    procedure SetAsteroids(const Value: TObjectList<TSAsteroidCardDTO>);
    procedure SetSelectedAsteroid(const Value: TSAsteroidDetailDTO);
    procedure SetHasSelectedAsteroid(const Value: Boolean);
    procedure SetErrorMessage(const Value: string);
    procedure SetHasError(const Value: Boolean);

  published
    property Filters: TSAsteroidFiltersDTO read GetFilters write SetFilters;
    property Summary: TSAsteroidSummaryDTO read GetSummary write SetSummary;
    property Asteroids: TObjectList<TSAsteroidCardDTO> read GetAsteroids write SetAsteroids;
    property SelectedAsteroid: TSAsteroidDetailDTO read GetSelectedAsteroid write SetSelectedAsteroid;
    property HasSelectedAsteroid: Boolean read GetHasSelectedAsteroid write SetHasSelectedAsteroid;
    property ErrorMessage: string read GetErrorMessage write SetErrorMessage;
    property HasError: Boolean read GetHasError write SetHasError;

  public
    constructor Create;
    destructor Destroy; override;
  end;

implementation

{ TSMonitoringDTO }

constructor TSMonitoringDTO.Create;
begin
  inherited;
  FAsteroids := TObjectList<TSAsteroidCardDTO>.Create;
  FFilters := TSAsteroidFiltersDTO.Create;
  FSummary := TSAsteroidSummaryDTO.Create;
  FSelectedAsteroid := TSAsteroidDetailDTO.Create;
end;

destructor TSMonitoringDTO.Destroy;
begin
  FAsteroids.Free;
  FFilters.Free;
  FSummary.Free;
  FSelectedAsteroid.Free;
  inherited
end;

function TSMonitoringDTO.GetAsteroids: TObjectList<TSAsteroidCardDTO>;
begin
  result := FAsteroids;
end;

function TSMonitoringDTO.GetErrorMessage: string;
begin
  result := FErrorMessage;
end;

function TSMonitoringDTO.GetFilters: TSAsteroidFiltersDTO;
begin
  result := FFilters;
end;

function TSMonitoringDTO.GetHasError: Boolean;
begin
  result := FHasError;
end;

function TSMonitoringDTO.GetHasSelectedAsteroid: Boolean;
begin
  result := FHasSelectedAsteroid;
end;

function TSMonitoringDTO.GetSelectedAsteroid: TSAsteroidDetailDTO;
begin
  result := FSelectedAsteroid;
end;

function TSMonitoringDTO.GetSummary: TSAsteroidSummaryDTO;
begin
  result := FSummary;
end;

procedure TSMonitoringDTO.SetAsteroids(const Value: TObjectList<TSAsteroidCardDTO>);
begin
  FAsteroids := Value;
end;

procedure TSMonitoringDTO.SetErrorMessage(const Value: string);
begin
  FErrorMessage := Value;
end;

procedure TSMonitoringDTO.SetFilters(const Value: TSAsteroidFiltersDTO);
begin
  FFilters := Value;
end;

procedure TSMonitoringDTO.SetHasError(const Value: Boolean);
begin
  FHasError := Value;
end;

procedure TSMonitoringDTO.SetHasSelectedAsteroid(const Value: Boolean);
begin
  FHasSelectedAsteroid := Value;
end;

procedure TSMonitoringDTO.SetSelectedAsteroid(const Value: TSAsteroidDetailDTO);
begin
  FSelectedAsteroid := Value;
end;

procedure TSMonitoringDTO.SetSummary(const Value: TSAsteroidSummaryDTO);
begin
  FSummary := Value;
end;

end.
