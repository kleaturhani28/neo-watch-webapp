<!DOCTYPE html>
<html lang="it" data-bs-theme="dark">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Asteroid Monitoring</title>

  <link rel="icon" href="data:,">

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.10.8/dist/sweetalert2.min.css" rel="stylesheet">


  <link href="/static/css/dashboardstyle.css" rel="stylesheet">

</head>

<body>
  <div class="app-shell">

    <!-- HEADER -->
    <header class="dashboard-header">
      <div class="brand-block">
        <div class="brand-logo">
          <i class="fa-solid fa-meteor"></i>
        </div>

        <div>
          <h1 class="brand-title">Asteroid Monitoring</h1>
          <div class="brand-subtitle">
            Real-time view of near-Earth asteroids, risk level and close approach data.
          </div>
        </div>
      </div>

      <div class="d-flex align-items-center flex-wrap gap-2">
        <span class="status-pill">
          <span class="status-dot"></span>
          Live data
        </span>

        <span class="status-pill">
          <i class="fa-solid fa-meteor text-info"></i>
          NASA NEO Dashboard
        </span>

        <span class="status-pill">
          <i class="fa-solid fa-triangle-exclamation text-warning"></i>
          Risk monitor
        </span>

        <button class="btn btn-sm btn-ghost" type="button" data-bs-toggle="modal" data-bs-target="#apiInfoModal">
          <i class="fa-solid fa-circle-info me-1"></i>
          About data
        </button>
      </div>
    </header>

    <!-- MAIN TABS -->
    <ul class="nav nasa-tabs mb-3" id="mainTab" role="tablist">

      <li class="nav-item" role="presentation">
        <button class="nav-link active" id="monitor-tab" data-bs-toggle="tab" data-bs-target="#monitor" type="button"
          role="tab">
          <i class="fa-solid fa-satellite-dish me-1"></i>
          Monitoring
        </button>
      </li>

      <li class="nav-item" role="presentation">
        <button class="nav-link" id="charts-tab" data-bs-toggle="tab" data-bs-target="#charts" type="button" role="tab">
          <i class="fa-solid fa-chart-line me-1"></i>
          Charts
        </button>
      </li>

    </ul>

    <div class="tab-content" id="mainTabContent">

      <!-- TAB MONITORING -->
      <div class="tab-pane fade show active" id="monitor" role="tabpanel" aria-labelledby="monitor-tab">
        <% monitoringHtml %>
      </div>

      <!-- TAB CHARTS -->
      <div class="tab-pane fade" id="charts" role="tabpanel" aria-labelledby="charts-tab">
        <% chartsHtml %>
      </div>

    </div>

    <!-- MODALE DATA INFO -->
    <div class="modal fade" id="apiInfoModal" tabindex="-1" aria-labelledby="apiInfoModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content bg-dark text-light border-secondary">
          <div class="modal-header">
            <h5 class="modal-title" id="apiInfoModalLabel">
              <i class="fa-solid fa-circle-info me-2"></i>
              About the data
            </h5>

            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>

          <div class="modal-body">
            <p>
              This dashboard tracks near-Earth objects using NASA NEO Dashboard data.
              Each object includes close approach information, estimated diameter, speed, miss distance and risk
              classification.
            </p>

            <p class="mb-0 text-secondary">
              The dashboard focuses on the monitoring experience: filtering, risk visibility and quick access to
              asteroid details.
            </p>
          </div>
        </div>
      </div>
    </div>

    <div id="globalLoader" class="loader-overlay htmx-indicator">
      <i class="fa-solid fa-spinner fa-spin me-2"></i>
      Loading...
    </div>

    <div id="toast-target" class="toast-target"></div>

  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://unpkg.com/htmx.org@1.9.12"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.10.8/dist/sweetalert2.all.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>

  <script src="/static/js/dashboard.js"></script>

 

</body>

</html>